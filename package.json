{
  "name": "automata-k",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "build:single": "npm run build && node scripts/build-single-file.mjs",
    "fonts": "python3 scripts/build-fonts.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "check:swift": "node scripts/check-swift-shape.mjs",
    "verify": "vitest run && npm run typecheck && node scripts/check-swift-shape.mjs && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "serve": "^14.2.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {},
  "type": "module",
  "description": "Draw a machine, watch it graded. Twelve levels up the Chomsky hierarchy.",
  "license": "MIT"
}
