{
  "name": "automata-k",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "playwright test",
    "typecheck": "tsc --noEmit",
    "verify": "vitest run && tsc --noEmit",
    "build:single": "expo export --platform web && node scripts/build-single-file.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "~19.2.0",
    "serve": "^14.2.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "expo": "^57.0.10",
    "expo-constants": "~57.0.9",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.10",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.10.1",
    "zustand": "^5.0.14"
  },
  "main": "expo-router/entry"
}
